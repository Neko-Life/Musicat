#ifndef MUSICAT_CONFIG_H
#define MUSICAT_CONFIG_H

// clang-format off

#define MUSICAT_VERSION_MAJOR @Musicat_VERSION_MAJOR@
#define MUSICAT_VERSION_MINOR @Musicat_VERSION_MINOR@
#define MUSICAT_VERSION_PATCH @Musicat_VERSION_PATCH@
#define MUSICAT_VERSION "@Musicat_VERSION_MAJOR@.@Musicat_VERSION_MINOR@.@Musicat_VERSION_PATCH@"

#ifdef MUSICAT_WITH_PYTHON
#define PYTHON_CMD @PYTHON_CMD@
#define PYTHON_VERSION_MAJOR @PYTHON_VERSION_MAJOR@
#define PYTHON_VERSION_MINOR @PYTHON_VERSION_MINOR@
#define PYTHON_VERSION_PATCH @PYTHON_VERSION_PATCH@
#define PYTHON_VERSION "@PYTHON_VERSION_MAJOR@.@PYTHON_VERSION_MINOR@.@PYTHON_VERSION_PATCH@"
#define PYTHON_INCLUDE @PYTHON_INCLUDE@
#endif // MUSICAT_WITH_PYTHON

// clang-format off

#endif // MUSICAT_CONFIG_H
