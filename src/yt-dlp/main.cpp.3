#define PY_SSIZE_T_CLEAN
#include <Python.h>

#include <csignal>
#include <string>
#include <unistd.h>

#define YTDLP_LIB "../../../libs/yt-dlp"
#define PWD_LIB "../../../src/yt-dlp"

#define INIT_SCRIPT(LIB_PATH)                                                                                                              \
    "import sys\n"                                                                                                                         \
    "sys.path.insert(0, '" PWD_LIB "')\n"                                                                                                  \
    "sys.path.insert(0, '" LIB_PATH "')\n"

inline constexpr const char module_ytdlp[] = "utils.ytdlp_run";
inline constexpr const char module_futures[] = "concurrent.futures";

struct py_obj_t
{
    PyObject *obj;

    py_obj_t () : obj (nullptr) {}
    py_obj_t (PyObject *const _obj) : obj (_obj) {}

    constexpr
    operator PyObject *() const noexcept
    {
        return obj;
    }

    // delete copy
    py_obj_t (const py_obj_t &) = delete;
    py_obj_t &operator= (const py_obj_t &) = delete;

    PyObject *
    operator= (PyObject *const o)
    {
        obj = o;
        return obj;
    }

    ~py_obj_t ()
    {
        if (!obj)
            return;
        Py_DECREF (obj);
        obj = nullptr;
    }
};

struct py_module_t
{
    py_obj_t mod;
    std::string name;

    py_module_t () = default;
    py_module_t (PyObject *_mod, std::string &_name) : mod (_mod), name (_name) {}
};

struct py_func_t
{
    py_obj_t func;
    std::string name;

    py_func_t () = default;
    py_func_t (PyObject *_func, std::string &_name) : func (_func), name (_name) {}
};

int
setup_module (py_module_t &mod, const char *module_name)
{
    PyObject *pName = PyUnicode_DecodeFSDefault (module_name);
    PyObject *pModule = PyImport_Import (pName);
    Py_DECREF (pName);

    if (!pModule)
        {
            PyErr_Print ();
            fprintf (stderr, "Failed to load \"%s\"\n", module_name);
            return 1;
        }
    mod.mod = pModule;
    mod.name = module_name;
    return 0;
}

int
get_func (py_module_t &mod, py_func_t &func, const char *func_name)
{
    PyObject *pFunc = PyObject_GetAttrString (mod.mod, func_name);

    if (pFunc && !PyCallable_Check (pFunc))
        {
            Py_DECREF (pFunc);
            fprintf (stderr, "Attribute \"%s\" in module \"%s\" is not a function\n", func_name, mod.name.c_str ());
            return 1;
        }
    else
        {
            PyErr_Print ();
            fprintf (stderr, "Module \"%s\" missing function \"%s\"\n", mod.name.c_str (), func_name);
            return 1;
        }
    func.func = pFunc;
    func.name = func_name;
    return 0;
}

int
get_func (py_obj_t &mod, py_func_t &func, const char *func_name)
{
    PyObject *pFunc = PyObject_GetAttrString (mod.obj, func_name);

    if (pFunc && !PyCallable_Check (pFunc))
        {
            Py_DECREF (pFunc);
            fprintf (stderr, "Attribute \"%s\" in object is not a function\n", func_name);
            return 1;
        }
    else
        {
            PyErr_Print ();
            fprintf (stderr, "Object is missing function \"%s\"\n", func_name);
            return 1;
        }
    func.func = pFunc;
    func.name = func_name;
    return 0;
}

int
setup_pArgs (PyObject **pArgs, PyObject **pValue, bool &has_pArgs)
{
    *pArgs = PyTuple_New (3);
    has_pArgs = true;

    // set max_entries here
    *pValue = PyLong_FromLong (2);
    if (!*pValue)
        {
            fprintf (stderr, "Cannot convert argument for max_entries\n");
            return 1;
        }
    /* pValue reference stolen here: */
    PyTuple_SetItem (*pArgs, 1, *pValue);

    *pValue = PyLong_FromLong (0);
    if (!*pValue)
        {
            fprintf (stderr, "Cannot convert argument for print_stdout\n");
            return 1;
        }
    /* pValue reference stolen here: */
    PyTuple_SetItem (*pArgs, 2, *pValue);
    return 0;
}

void
run ()
{
    py_module_t ytdlp_module;
    py_func_t ytdlp_run_func;

    py_module_t futures_module;
    py_func_t futures_ThreadPoolExecutor_func;

    py_obj_t executor;
    py_func_t executor_submit;

    py_obj_t dict = PyDict_New ();

    PyObject *pArgs, *pValue;
    bool has_pArgs = false;

    char c[1024 + 1];
    size_t s = 0;

    bool end = false;
    end = true;

    if (setup_module (ytdlp_module, module_ytdlp))
        goto end;
    if (setup_module (futures_module, module_futures))
        goto end;
    if (get_func (ytdlp_module, ytdlp_run_func, "run"))
        goto end;
    if (get_func (futures_module, futures_ThreadPoolExecutor_func, "ThreadPoolExecutor"))
        goto end;

    // setup ThreadPoolExecutor
    PyDict_SetItem (dict, PyUnicode_DecodeFSDefault ("TPE"), futures_ThreadPoolExecutor_func.func);
    executor = PyRun_String ("print('test')\n", Py_single_input, dict, NULL);
    if (!executor)
        {
            PyErr_Print ();
            goto end;
        }

    if (get_func (executor, executor_submit, "submit"))
        goto end;

    if (setup_pArgs (&pArgs, &pValue, has_pArgs))
        goto end;

    while (!end && (s = read (STDIN_FILENO, c, 1024)))
        {
            // if (!PyThreadState_GetUnchecked () || PyThreadState_GetUnchecked () != main_thread_state)
            //     PyThreadState_Swap (main_thread_state);

            if (end || s <= 0)
                break;

            c[s] = '\0';
            if (c[s - 1] == '\n')
                c[s - 1] = '\0';

            std::string strurl = std::string ("ytsearch2:") + std::string (c);

            pValue = PyUnicode_FromStringAndSize (strurl.c_str (), strurl.size ());
            if (!pValue)
                {
                    fprintf (stderr, "Cannot convert argument for url\n");
                    end = true;
                    break;
                }
            /* pValue reference stolen here: */
            PyTuple_SetItem (pArgs, 0, pValue);

            pValue = PyObject_CallObject (ytdlp_run_func.func, pArgs);
            if (pValue != NULL)
                {
                    const char *res = PyUnicode_AsUTF8AndSize (pValue, NULL);
                    fprintf (stderr, "%s\n", res);
                    Py_DECREF (pValue);
                }
            else
                {
                    PyErr_Print ();
                    fprintf (stderr, "Call run failed with argument: `%s`\n", strurl.c_str ());
                    end = true;
                    break;
                }
        }

end:
    if (has_pArgs)
        Py_DECREF (pArgs);
}

int
main (int argc, char *argv[])
{
    PyStatus status;
    PyConfig config;
    PyThreadState *main_thread_state;
    PyInterpreterState *main_interpreter_state;
    PyConfig_InitPythonConfig (&config);
    config.isolated = 1;

    /* optional but recommended */
    status = PyConfig_SetBytesString (&config, &config.program_name, argv[0]);
    if (PyStatus_Exception (status))
        goto exception;

    status = Py_InitializeFromConfig (&config);
    if (PyStatus_Exception (status))
        goto exception;

    // done with configuration here
    PyConfig_Clear (&config);
    main_thread_state = PyThreadState_Get ();
    main_interpreter_state = PyThreadState_GetInterpreter (main_thread_state);

    PyRun_SimpleString (INIT_SCRIPT (YTDLP_LIB));

    run ();

    if (Py_FinalizeEx () < 0)
        exit (120);

    return 0;

exception:
    PyConfig_Clear (&config);
    Py_ExitStatusException (status);
}
